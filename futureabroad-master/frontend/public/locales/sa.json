  "terms": {
    "title": "नियमाः च शर्ताः",
    "updated": "अन्तिमं अद्यतनम्: अप्रिल् २०२६",
    "s1_title": "1. नियमानां स्वीकृतिः",
    "s1_body": "माईफ्यूचरअब्रोड् इत्यस्मिन् प्रवेशेण वा उपयोगेन भवतः एतेषां नियमानां च शर्तीनां च पालनं कर्तुं सहमतिः भवति। यदि भवतः असहमतिः अस्ति तर्हि कृपया मंचं मा उपयुङ्क्तु।",
    "s2_title": "२. मञ्चस्य उपयोगः",
    "s2_body": "माईफ्यूचरअब्रोड् विदेशगमनयोजनां कुर्वन्तः व्यक्तीनां साहाय्याय सूचना-साधनानि च प्रददाति।   एषः मंचः केवलं व्यक्तिगत-अवाणिज्यिक-उपयोगार्थम् अस्ति।   त्वं सेवायाः कञ्चन विशेषतां दुरुपयोगं वा दुर्व्यवहारं कर्तुं न अर्हसि।",
    "s3_title": "३. सूचनायाः यथार्थता",
    "s3_body": "वयं वीसा-सेवा-सूचनानां यथार्थतां रक्षितुं यतामहे, परन्तु किञ्चित् आश्वासनं न कुर्मः।  आप्रवासननियमाः बारम्बारं परिवर्तन्ते — निर्णयं कर्तुं पूर्वं सदा अधिकृतसरकारीस्रोतैः विवरणानि परीक्षस्व।",
    "s4_title": "४. तृतीयपक्षसेवाः",
    "s4_body": "माईफ्यूचरअब्रोड् तृतीयपक्षसेवाभ्यः (उदाहरणार्थ ट्रिप्.कॉम्, सेवाप्रदातारः) संलग्नयति। वयं तेषां तृतीयपक्षाणां विषयवस्तु, यथार्थता वा आचरणानि प्रति उत्तरदायित्वं न वहामः।",
    "s5_title": "५. उत्तरदायित्वस्य सीमा",
    "s5_body": "यथा विधिना अनुमतं पूर्णतया, मय्फ्यूचर्अब्रॉड् तव मञ्चोपयोगेन उत्पन्नानां अप्रत्यक्ष-दुर्घटनात्मक-परिणामदोषानां कृते उत्तरदायित्वं न वहति।",
    "s6_title": "६. नियमानां परिवर्तनानि",
    "s6_body": "वयं एतान् नियमान् कालकाले संशोधयितुं शक्नुमः। परिवर्तनानन्तरं मञ्चस्य निरन्तरं उपयोगः नव नियमानां स्वीकृतिं सूचयति।",
    "s7_title": "सम्पर्कः",
    "s7_body": "एतेषां नियमानां विषये यदि काचित् प्रश्नः स्यात्, कृपया समर्थनपृष्ठेन सम्पर्कं कुर्वन्तु।"
  },
  "privacy": {
    "title": "गोपनीयता सूचना",
    "updated": "अन्तिमं अद्यतनम्: अप्रिल् २०२६",
    "s1_title": "वयं के स्मः",
    "s1_body": "माईफ्यूचरअब्रोड् एकः मंचः अस्ति यः व्यक्तीनाम् विदेशगमनस्य योजनां कर्तुं तथा व्यवस्थापनं कर्तुं साहाय्यं करोति।   'वयम्', 'अस्मान्', 'अस्माकं' इति पदाः माईफ्यूचरअब्रोड् इत्यस्मै निर्देशयन्ति।",
    "s2_title": "२. वयं का दत्तांशं सङ्गृह्णामः",
    "s2_body": "वयं तव खाता-निर्माणकाले प्रदत्तां सूचनां (नाम, ईमेल्-पत्ता) तथा मञ्चस्य उपयोगेन उत्पन्नां दत्तांशं (उदाहरणार्थं संरक्षिताः वीसाः, सूचीपरीक्षणानि, दस्तावेजाः, सन्देशाः) सङ्गृह्णामः।",
    "s3_title": "३. वयं कथं भवतः दत्तांशं उपयुजामः",
    "s3_body": "तव दत्तानि MyFutureAbroad सेवां प्रदातुं तथा सा सुधारयितुं, तव अनुभवम् व्यक्तिगतं कर्तुं, तथा तव खाता वा आरक्षणानि विषये संवादं कर्तुं प्रयुज्यन्ते। वयं तव व्यक्तिगतदत्तानि तृतीयपक्षेभ्यः न विक्रयामः।",
    "s4_title": "४. दत्तसञ्चयः",
    "s4_body": "तव दत्तांशः सुपैबेस्-उपयोगेन सुरक्षिततया सञ्चितः अस्ति।वयं तव सूचनां रक्षितुं उद्योगमानकानि सुरक्षा-उपायान् आचरन्ति।",
    "s5_title": "५. कुकीज़् तथा स्थानीय सञ्चयः",
    "s5_body": "वयं ब्राउज़र्-स्थानीय-संग्रहणम् भवतः इच्छानुसारविन्यासान् (उदाहरणार्थं विषयविन्यासः, अनुमतिस्वीकृतिः) स्मर्तुं उपयुजामः। अनुमतिविना भवतः यन्त्रे अनुगमनाय कुकीज् न स्थाप्यन्ते।",
    "s6_title": "६. तव अधिकाराः",
    "s6_body": "त्वं कदापि स्वव्यक्तिगतदत्तांशान् प्राप्तुम्, संशोधितुम् वा मेटयितुम् अधिकारवान् असि। एतानि अधिकाराणि प्रवर्तयितुम् कृपया समर्थनपृष्ठेन सम्पर्कं कुरु।",
    "s7_title": "७. अस्मिन् सूचने परिवर्तनानि",
    "s7_body": "वयं समयसमये एतत् गोपनीयता-सूचनापत्रम् अद्यतनीकर्तुं शक्नुमः।  वयं महत्त्वपूर्णपरिवर्तनानां विषये ईमेल् अथवा अनुप्रयोगे अन्तर्गते सूचनापत्रेण त्वां सूचयिष्यामः।",
    "s8_title": "सम्पर्कः",
    "s8_body": "गोपनीयतासम्बद्धेषु प्रश्नेषु कृपया समर्थनपृष्ठे सम्पर्कं कुर्वन्तु।"
  },
