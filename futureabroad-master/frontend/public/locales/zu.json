  "terms": {
    "title": "Imigomo Nemibandela",
    "updated": "Kubuyekezwe okokugcina: Ephreli 2026",
    "s1_title": "1. Ukwamukela Imigomo",
    "s1_body": "Ngokufinyelela noma ngokusebenzisa i-MyFutureAbroad, uyavuma ukuboshwa yilezi Zimo Nemibandela. Uma ungavumelani, sicela ungayisebenzisi le pulatifomu.",
    "s2_title": "2. Ukusetshenziswa Kwepulatifomu",
    "s2_body": "MyFutureAbroad inikeza imininingwane namathuluzi okusiza abantu abahlela ukuthuthela phesheya. Le pulatifomu ingeyokusetshenziswa komuntu siqu kuphela, hhayi ngenhloso yokuhweba. Awuvunyelwe ukusebenzisa kabi noma ukuphatha kabi noma yiziphi izici zesevisi.",
    "s3_title": "3. Ukuqiniseka Kolwazi",
    "s3_body": "Sizama ukugcina ulwazi lwe-visa nolwazi lwezinsizakalo lulungile, kodwa asinikezi iziqinisekiso. Imithetho yokungena ezweni ishintsha kaningi — hlale uqinisekisa imininingwane emithonjeni esemthethweni kahulumeni ngaphambi kokwenza izinqumo.",
    "s4_title": "4. Izinsizakalo Zomuntu Wesithathu",
    "s4_body": "MyFutureAbroad ixhumanisa nezinsizakalo zomuntu wesithathu (isb. Trip.com, abahlinzeki bezinsizakalo). Asinasibopho ngokuqukethwe, ukunemba, noma imikhuba yalabo bantu besithathu.",
    "s5_title": "5. Ukuvinjelwa komthwalo wemfanelo",
    "s5_body": "Ngokugcwele okuvunyelwe ngumthetho, i-MyFutureAbroad ngeke ibe nesibopho nganoma yiziphi izimali-mboleko ezingaqondile, ezenzeka ngokungahleliwe, noma eziphumela ngenxa yokusebenzisa kwakho ipulatifomu.",
    "s6_title": "6. Izinguquko ezimisweni",
    "s6_body": "Singavuselela lezi Zimiso ngezikhathi ezithile. Ukuqhubeka nokusebenzisa ipulatifomu ngemva kwezinguquko kubonisa ukwamukela lezi Zimiso ezintsha.",
    "s7_title": "7. Xhumana",
    "s7_body": "Uma unemibuzo mayelana nalezi Zimo, sicela uxhumane nathi ekhasini Lokweseka."
  },
  "privacy": {
    "title": "Isaziso Sobumfihlo",
    "updated": "Kubuyekezwe okokugcina: Ephreli 2026",
    "s1_title": "1. Singobani",
    "s1_body": "MyFutureAbroad iyinkundla esiza abantu ukuhlela nokuphatha ukuthuthela kwabo phesheya. Izisho ezithi \"thina\", \"kithi\" noma \"ethu\" zibhekisela ku-MyFutureAbroad.",
    "s2_title": "2. Lini Idatha Esiyiqoqayo",
    "s2_body": "Siqoqa imininingwane oyinikezayo lapho udala i-akhawunti (igama, ikheli le-imeyili) kanye nedatha ekhiqizwa ngokusebenzisa kwakho ipulatifomu (isb. ama-visa agciniwe, izinhlu zokuhlola, imibhalo, imilayezo).",
    "s3_title": "3. Indlela Esisebenzisa Ngayo Idatha Yakho",
    "s3_body": "Idatha yakho isetshenziselwa ukuhlinzeka nokuthuthukisa insizakalo ye-MyFutureAbroad, ukuzenza isipiliyoni sakho sibe ngokwakho, nokuxhumana nawe mayelana ne-akhawunti yakho noma ukubhuka kwakho. Asidayisi idatha yakho siqu kubantu besithathu.",
    "s4_title": "4. Ukugcinwa kwedatha",
    "s4_body": "Idatha yakho igcinwa ngokuphepha usebenzisa i-Supabase. Sisebenzisa izinyathelo zokuphepha ezijwayelekile embonini ukuvikela ulwazi lwakho.",
    "s5_title": "5. Amakhukhi nokugcinwa kwendawo",
    "s5_body": "Sisebenzisa isitoreji sendawo sebhrawuza ukukhumbula izintandokazi zakho (isb. itimu, ukuvuma kwemvume). Akukho ama-cookie okulandelela afakwa kudivayisi yakho ngaphandle kwemvume.",
    "s6_title": "6. Amalungelo Akho",
    "s6_body": "Unelungelo lokufinyelela, lokulungisa, noma lokususa idatha yakho siqu nganoma yisiphi isikhathi. Ukuze usebenzise lawa malungelo, xhumana nathi ekhasini Lokweseka.",
    "s7_title": "7. Izinguquko kulesi saziso",
    "s7_body": "Singase sibuyekeze Lesi Saziso Sobumfihlo ngezikhathi ezithile. Sizokwazisa ngezinguquko ezinkulu nge-imeyili noma ngesaziso ngaphakathi kohlelo lokusebenza.",
    "s8_title": "8. Xhumana",
    "s8_body": "Uma unemibuzo ephathelene nobumfihlo, sicela uxhumane nathi ekhasini lokwesekwa."
  },
