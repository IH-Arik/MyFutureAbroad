  "terms": {
    "title": "Ehdot ja edellytykset",
    "updated": "Viimeksi päivitetty: huhtikuu 2026",
    "s1_title": "1. Ehtojen hyväksyminen",
    "s1_body": "Käyttäessäsi MyFutureAbroad-sivustoa tai käyttäessäsi sitä sitoudut noudattamaan näitä käyttöehtoja. Jos et hyväksy näitä ehtoja, älä käytä alustaa.",
    "s2_title": "2. Alustan käyttö",
    "s2_body": "MyFutureAbroad tarjoaa tietoa ja työkaluja ulkomaille muuttoa suunnittelevien henkilöiden avuksi. Alusta on tarkoitettu vain henkilökohtaiseen, ei-kaupalliseen käyttöön. Palvelun ominaisuuksia ei saa käyttää väärin tai väärinkäyttää.",
    "s3_title": "3. Tietojen oikeellisuus",
    "s3_body": "Pyrimme pitämään viisumi- ja palvelutiedot paikkansapitävinä, mutta emme anna mitään takeita. Maahanmuuttosäännöt muuttuvat usein - tarkista tiedot aina virallisista viranomaislähteistä ennen päätöksentekoa.",
    "s4_title": "4. Kolmannen osapuolen palvelut",
    "s4_body": "MyFutureAbroad linkittää kolmansien osapuolten palveluihin (esim. Trip.com, palveluntarjoajat). Emme ole vastuussa näiden kolmansien osapuolten sisällöstä, tarkkuudesta tai käytännöistä.",
    "s5_title": "5. Vastuun rajoittaminen",
    "s5_body": "MyFutureAbroad ei ole lain sallimissa rajoissa vastuussa mistään epäsuorista, satunnaisista tai välillisistä vahingoista, jotka aiheutuvat alustan käytöstäsi.",
    "s6_title": "6. Muutokset ehtoihin",
    "s6_body": "Saatamme päivittää näitä ehtoja aika ajoin. Alustan käytön jatkaminen muutosten jälkeen merkitsee uusien ehtojen hyväksymistä.",
    "s7_title": "7. Yhteystiedot",
    "s7_body": "Jos sinulla on kysyttävää näistä ehdoista, ota meihin yhteyttä Tukisivun kautta."
  },
  "privacy": {
    "title": "Tietosuojailmoitus",
    "updated": "Viimeksi päivitetty: huhtikuu 2026",
    "s1_title": "1. Keitä me olemme",
    "s1_body": "MyFutureAbroad on alusta, joka auttaa yksityishenkilöitä suunnittelemaan ja hallinnoimaan muuttoa ulkomaille. Viittaukset \"me\", \"meitä\" tai \"meidän\" viittaavat MyFutureAbroadiin.",
    "s2_title": "2. Mitä tietoja keräämme",
    "s2_body": "Keräämme tietoja, jotka annat tiliä luodessasi (nimi, sähköpostiosoite), ja tietoja, jotka syntyvät alustan käytön aikana (esim. tallennetut viisumit, tarkistuslistat, asiakirjat, viestit).",
    "s3_title": "3. Miten käytämme tietojasi",
    "s3_body": "Tietojasi käytetään MyFutureAbroad-palvelun tarjoamiseen ja parantamiseen, käyttökokemuksesi henkilökohtaistamiseen sekä tiliäsi tai varauksiasi koskevaan viestintään. Emme myy henkilötietojasi kolmansille osapuolille.",
    "s4_title": "4. Tietojen tallentaminen",
    "s4_body": "Tietojasi säilytetään turvallisesti Supabasen avulla. Käytämme alan standardien mukaisia turvatoimia tietojesi suojaamiseksi.",
    "s5_title": "5. Evästeet ja paikallinen tallennus",
    "s5_body": "Käytämme selaimen paikallista tallennustilaa muistamaan asetuksesi (esim. teema, suostumuksen vahvistaminen). Laitteeseesi ei sijoiteta seurantaevästejä ilman suostumusta.",
    "s6_title": "6. Oikeutesi",
    "s6_body": "Sinulla on oikeus saada pääsy henkilötietoihisi, korjata tai poistaa ne milloin tahansa. Voit käyttää näitä oikeuksia ottamalla meihin yhteyttä tukisivun kautta.",
    "s7_title": "7. Muutokset tähän ilmoitukseen",
    "s7_body": "Saatamme päivittää tätä tietosuojailmoitusta aika ajoin. Ilmoitamme sinulle merkittävistä muutoksista sähköpostitse tai sovelluksen sisäisellä ilmoituksella.",
    "s8_title": "8. Yhteystiedot",
    "s8_body": "Jos sinulla on yksityisyyteen liittyviä kysymyksiä, ota yhteyttä tukisivun kautta."
  },
