# Backend Server
BACKEND_PORT=3001
FRONTEND_URL=http://localhost:5173

# FastAPI AI backend URL (MyFutureAbroad Python service)
# Development: http://localhost:8000
# Production: set to the deployed FastAPI service URL
FASTAPI_BASE_URL=http://localhost:8000

# Stripe
STRIPE_PUBLIC_KEY=pk_test_XXX
STRIPE_SECRET_KEY=sk_test_XXX

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI (AI chat feature)
OPENAI_API_KEY=sk-...your-openai-key...
OPENAI_MODEL=gpt-4o-mini

# DeepL
DEEPL_API_KEY=your-deepl-api-key
# Resend (email)
RESEND_API_KEY=your-resend-api-key
SUPPORT_EMAIL=customersupport@myfutureabroad.com
SUPPORT_FROM_EMAIL=no-reply@myfutureabroad.com

# SMTP fallback (if you prefer SMTP)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=your-smtp-password
SMTP_ADMIN_EMAIL=admin@app.myfutureabroad.com
SMTP_SENDER_NAME="MyFutureAbroad"
