# ============================================================
# MyFutureAbroad Docker Compose Environment Variables
# ============================================================
# Copy this file to the root directory of your project
# Usage: docker-compose will automatically load these variables

# ============================================================
# FRONTEND CONFIGURATION
# ============================================================
# These are passed as build arguments to compile the frontend app
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================
# BACKEND CONFIGURATION
# ============================================================
BACKEND_PORT=3001
FRONTEND_URL=http://localhost:2341

# Stripe Payment Processing
STRIPE_PUBLIC_KEY=pk_test_YOUR_STRIPE_PUBLIC_KEY
STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_STRIPE_WEBHOOK_SECRET

# Supabase Backend Access (Service Role for admin operations)
# Use Service Role Key for backend (has all permissions)
# Note: Never expose this to frontend
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================
# DIRECTUS ADMIN CMS
# ============================================================
# Admin credentials (change these immediately in production!)
DIRECTUS_ADMIN_EMAIL=admin@myfutureabroad.local
DIRECTUS_ADMIN_PASSWORD=ChangeMe123!

# Database connection URL (from Supabase)
# Format: postgresql://user:password@host:port/database
# Get from Supabase: Settings > Database > Connection string > PostgreSQL
DATABASE_URL=postgresql://postgres:your-password@db.supabase.co:5432/postgres

# Directus security keys (generate random strings for production)
DIRECTUS_KEY=generate-a-random-32-character-key-here
DIRECTUS_SECRET=generate-a-random-32-character-secret-here

# ============================================================
# SERVER URL (for ngrok/external access)
# ============================================================
# Optional: Set this if exposing the app externally
SERVER_URL=http://localhost:2341
